{
  "name": "@iouinator/desktop",
  "productName": "IOUinator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "IOUinator desktop app (Electron).",
  "main": "out/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "start": "pnpm build && node scripts/start.mjs",
    "package": "pnpm build && electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@iouinator/web": "workspace:*",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  }
}
