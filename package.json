{
  "name": "iouinator",
  "private": true,
  "type": "module",
  "description": "IOUinator — keeps track of who owes whom, with a Mermaid diagram of the totals, for the desktop (Electron) and the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r --filter './apps/*' run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
